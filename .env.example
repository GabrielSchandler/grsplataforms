# Copie para .env.local. Como o build é estático, estas variáveis são
# embutidas no HTML durante o `npm run build` — mudar qualquer uma exige
# gerar o build de novo.
#
# Todas são OPCIONAIS: os dados da empresa e a linha comercial do CRM já
# estão como padrão em src/lib/site-config.ts. Use este arquivo para
# sobrescrever em ambiente de teste ou quando algo mudar.

# Endereço final do site. Entra no canonical, no Open Graph e no sitemap.
# Padrão do código: https://www.newsec.com.br (produção, com www).
# Só preencha para apontar um ambiente de teste para outro endereço.
NEXT_PUBLIC_SITE_URL=

# WhatsApp comercial, com DDI e DDD, somente dígitos.
# ⚠️ O padrão 5511963322546 é a MESMA linha do site institucional da GRS, e
# o perfil dela no WhatsApp aparece como GRS Soluções. Enquanto for esse
# número, o primeiro contato revela a desenvolvedora e anula a marca
# NewSec. Preencher com uma linha própria.
NEXT_PUBLIC_WHATSAPP=

# E-mail comercial exibido no rodapé.
# ⚠️ Sem valor, a linha some do rodapé. O antigo
# (planejamento@grssolucao.com.br) saiu porque o domínio entrega a
# desenvolvedora. Preencher com um e-mail no domínio da NewSec.
NEXT_PUBLIC_EMAIL_COMERCIAL=

# Link de agendamento (Cal.com, Calendly, Google). Quando preenchido, vira
# o destino do CTA principal no lugar do WhatsApp.
NEXT_PUBLIC_AGENDA_URL=

# Ambiente de demonstração público, se um dia existir. Preenchido, troca o
# botão "Pedir acesso de avaliação" por "Abrir ambiente de demonstração".
NEXT_PUBLIC_DEMO_URL=

# Medição (GA4). Vazio = nenhum script de terceiro e nenhum cookie.
# Antes de preencher, leia a nota sobre consentimento no README.
NEXT_PUBLIC_ANALYTICS_ID=

# Identificação legal da empresa. NÃO aparece mais no rodapé nem nos dados
# estruturados — é usada só na página de privacidade, onde a LGPD exige que
# o controlador dos dados seja identificável.
# Padrões: GRS Soluções · 63.562.890/0001-45
NEXT_PUBLIC_RAZAO_SOCIAL=
NEXT_PUBLIC_CNPJ=

# Endereço do painel do NewSec Focus — destino do link "Entrar" em /focus.
# Padrão do código: https://newsecfocus.vercel.app
# ⚠️ Esse endereço nomeia o fornecedor de hospedagem, o que a regra de venda
# manda evitar. Trocar quando o painel ganhar subdomínio próprio
# (focus.newsec.com.br): o agente fala direto com o banco e não é afetado; o
# que muda é o domínio na hospedagem, o DNS e os endereços de retorno do login.
NEXT_PUBLIC_PAINEL_FOCUS=
